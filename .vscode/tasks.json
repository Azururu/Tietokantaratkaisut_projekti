{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: run",
      "type": "shell",
      "command": "./mvnw spring-boot:run",
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "DB: install transactions (04)",
      "type": "shell",
      "command": "mariadb ${input:database} < sql/04_transactions.sql && echo 'Procedures installed.'",
      "problemMatcher": []
    },
    {
      "label": "DB: run transaction tests (04)",
      "type": "shell",
      "command": "mariadb --force -t ${input:database} < sql/04_transactions_test.sql",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "DB: run view tests (06)",
      "type": "shell",
      "command": "mariadb --default-character-set=utf8mb4 -t ${input:database} < sql/06_views_test.sql",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "database",
      "type": "pickString",
      "description": "Database to run against",
      "options": [
        "webstore_scratch",
        "webstore"
      ],
      "default": "webstore_scratch"
    }
  ]
}
